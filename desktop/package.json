{
  "name": "fetchly-desktop",
  "productName": "Fetchly",
  "version": "1.0.0",
  "description": "Fetchly - download videos and images",
  "author": "Fetchly",
  "main": "main.js",
  "scripts": {
    "prepare-vendor": "node scripts/prepare.js",
    "icon": "node scripts/make-icon.js",
    "start": "electron .",
    "dist": "node scripts/prepare.js && electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "ffmpeg-static": "^5.2.0"
  },
  "build": {
    "appId": "app.fetchly.desktop",
    "productName": "Fetchly",
    "directories": { "output": "dist" },
    "files": ["main.js", "package.json"],
    "extraResources": [
      { "from": "../main.py", "to": "app/main.py" },
      { "from": "../templates", "to": "app/templates" },
      { "from": "../static", "to": "app/static" },
      { "from": "vendor/python", "to": "python" },
      { "from": "vendor/pylib", "to": "pylib" },
      { "from": "vendor/ffmpeg", "to": "ffmpeg" }
    ],
    "win": { "target": "nsis", "icon": "assets/icon.png" },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "deleteAppDataOnUninstall": false
    }
  }
}
