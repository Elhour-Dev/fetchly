{
  "name": "fetchly-desktop",
  "productName": "Fetchy",
  "version": "1.2.1",
  "description": "Fetchy - download videos and images",
  "author": "Fetchy",
  "main": "main.js",
  "scripts": {
    "prepare-vendor": "node scripts/prepare.js",
    "start": "electron .",
    "dist": "node scripts/prepare.js && electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.fetchly.desktop",
    "productName": "Fetchy",
    "directories": { "output": "dist" },
    "files": ["main.js", "update.js", "package.json", "assets/icon.ico"],
    "extraResources": [
      { "from": "../main.py", "to": "app/main.py" },
      { "from": "../fetchy", "to": "app/fetchy", "filter": ["**/*.py"] },
      { "from": "../THIRD_PARTY_NOTICES.md", "to": "THIRD_PARTY_NOTICES.md" },
      { "from": "../templates", "to": "app/templates" },
      { "from": "../static", "to": "app/static" },
      { "from": "vendor/python", "to": "python" },
      { "from": "vendor/pylib", "to": "pylib" },
      { "from": "vendor/ffmpeg", "to": "ffmpeg" }
    ],
    "win": { "target": "nsis", "icon": "assets/icon.ico", "artifactName": "Fetchy-Setup-${version}.exe" },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "deleteAppDataOnUninstall": false
    }
  }
}
